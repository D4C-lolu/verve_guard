    {
      "name": "Stress Tests",
      "description": "200 concurrent request stress tests. Run via Postman Runner with iterations=1. Each request uses a unique reference generated via pre-request script.",
      "item": [
        {
          "name": "Setup - Login & Store Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "pm.test('Login successful for stress test', () => {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Stress - Single Transfer Request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ref = 'STRESS-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9).toUpperCase();",
                  "pm.collectionVariables.set('transferReference', ref);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseTime = pm.response.responseTime;",
                  "pm.test('Response received', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
                  "});",
                  "pm.test('Response time under 2000ms', () => {",
                  "  pm.expect(responseTime).to.be.below(2000);",
                  "});",
                  "const results = pm.collectionVariables.get('stressResults') ? JSON.parse(pm.collectionVariables.get('stressResults')) : { total: 0, success: 0, failed: 0, times: [] };",
                  "results.total++;",
                  "results.times.push(responseTime);",
                  "if (pm.response.code === 201) results.success++;",
                  "else results.failed++;",
                  "pm.collectionVariables.set('stressResults', JSON.stringify(results));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{transferReference}}\",\n  \"fromAccountId\": \"{{stressFromAccountId}}\",\n  \"toAccountId\": \"{{stressToAccountId}}\",\n  \"amount\": 1.00,\n  \"currency\": \"NGN\",\n  \"description\": \"Stress test transfer\",\n  \"cardNumber\": \"{{stressCardNumber}}\"\n}"
            }
          }
        },
        {
          "name": "Stress - Fraud Evaluate Request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const cards = ['4111111111111111','4222222222222222','4333333333333333','4444444444444444','4555555555555555'];",
                  "const card = cards[Math.floor(Math.random() * cards.length)];",
                  "pm.collectionVariables.set('stressCardNumber', card);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseTime = pm.response.responseTime;",
                  "pm.test('Fraud evaluate responded', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Fraud response under 100ms overhead', () => {",
                  "  pm.expect(responseTime).to.be.below(100);",
                  "});",
                  "const json = pm.response.json();",
                  "console.log('Fraud status:', json.data, '| Response time:', responseTime + 'ms');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fraud/evaluate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"{{stressCardNumber}}\",\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": 5001.00,\n  \"currency\": \"NGN\"\n}"
            }
          }
        },
        {
          "name": "Stress - Results Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const results = pm.collectionVariables.get('stressResults') ? JSON.parse(pm.collectionVariables.get('stressResults')) : { total: 0, success: 0, failed: 0, times: [] };",
                  "const times = results.times.sort((a, b) => a - b);",
                  "const avg = times.length ? Math.round(times.reduce((a, b) => a + b, 0) / times.length) : 0;",
                  "const p95 = times.length ? times[Math.floor(times.length * 0.95)] : 0;",
                  "const p99 = times.length ? times[Math.floor(times.length * 0.99)] : 0;",
                  "console.log('=== Stress Test Results ===');",
                  "console.log('Total requests:    ' + results.total);",
                  "console.log('Successful:        ' + results.success);",
                  "console.log('Failed:            ' + results.failed);",
                  "console.log('Avg response time: ' + avg + 'ms');",
                  "console.log('P95 response time: ' + p95 + 'ms');",
                  "console.log('P99 response time: ' + p99 + 'ms');",
                  "console.log('===========================');",
                  "pm.test('Average response time within SLA', () => {",
                  "  pm.expect(avg).to.be.below(2000);",
                  "});",
                  "pm.collectionVariables.set('stressResults', JSON.stringify({ total: 0, success: 0, failed: 0, times: [] }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{actuatorUrl}}/health"
          }
        }
      ]
    },
