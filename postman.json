          "name": "Change User Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/status?status=SUSPENDED",
              "query": [{ "key": "status", "value": "SUSPENDED" }]
